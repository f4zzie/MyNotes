---
import { SITE } from "../lib/site.mjs";
const year = 2026;
const { noteCount = 0, categoryCount = 0 } = Astro.props;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="footer-brand-logo" aria-label="f4zzie.dev home">
          <span class="logo-text">f4zzie</span><span class="logo-accent">.dev</span>
        </a>
        <p class="footer-tagline">
          A public archive of cybersecurity research — malware analysis, reverse engineering,
          binary exploitation, Hack The Box and CTF writeups.
          {noteCount > 0 && <> Currently indexing {noteCount} notes across {categoryCount} tracks.</>}
        </p>
      </div>

      <div>
        <h2 class="footer-col-title">Navigate</h2>
        <div class="footer-nav">
          <a href="/" class="footer-link">Home</a>
          <a href="/notes" class="footer-link">Research Notes</a>
          <a href="/about" class="footer-link">About</a>
          <a href="/rss.xml" class="footer-link">RSS Feed</a>
        </div>
      </div>

      <div>
        <h2 class="footer-col-title">Tracks</h2>
        <div class="footer-nav">
          <a href="/category/malware-analysis" class="footer-link">Malware Analysis</a>
          <a href="/category/binary-exploitation" class="footer-link">Binary Exploitation</a>
          <a href="/category/reverse-engineering" class="footer-link">Reverse Engineering</a>
          <a href="/category/htb-writeup" class="footer-link">HTB Writeups</a>
        </div>
      </div>

      <div>
        <h2 class="footer-col-title">Connect</h2>
        <div class="mt-1 flex gap-2.5">
          <a href={SITE.github} target="_blank" rel="noreferrer me" aria-label="GitHub" class="icon-link">
            <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.31-.54-1.53.11-3.19 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.19.77.84 1.23 1.92 1.23 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>
          </a>
          <a href={SITE.x} target="_blank" rel="noreferrer me" aria-label="X" class="icon-link">
            <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href={SITE.htb} target="_blank" rel="noreferrer" aria-label="Hack The Box" class="icon-link">
            <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current"><path d="M11.996 0 1.66 6v12l10.336 6 10.343-6V6L11.996 0zm6.86 7.98v8.05l-6.86 3.98-6.853-3.98V7.98l6.853-3.98 6.86 3.98zm-6.86.02-4.02 2.33v.02l4.02 2.33 4.02-2.33-4.02-2.35z"/></svg>
          </a>
          <a href={`mailto:${SITE.email}`} aria-label="Email" class="icon-link">
            <svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} f4zzie.dev — built from a public research vault.</span>
      <a href="/rss.xml" class="footer-link">RSS</a>
    </div>
  </div>
</footer>

---
import { SITE } from "../lib/site.mjs";
const path = Astro.url.pathname;
const isActive = (href) => (href === "/" ? path === "/" : path.startsWith(href));
const links = [
  { href: "/", label: "~/home" },
  { href: "/notes", label: "~/writeups" },
  { href: "/about", label: "~/about" },
];
---
<header class="site-header">
  <div class="container-wide header-content">
    <a href="/" class="logo" aria-label="f4zzie.dev home">
      <span class="p">f4zzie</span><span class="u">@dev</span><span class="path">:~$</span><span class="cursor">&nbsp;_</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class={isActive(l.href) ? "active" : ""}>{l.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href={SITE.github} target="_blank" rel="noreferrer me" aria-label="GitHub" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.31-.54-1.53.11-3.19 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.19.77.84 1.23 1.92 1.23 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>
      </a>
      <a href={SITE.x} target="_blank" rel="noreferrer me" aria-label="X" class="icon-btn">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <button id="nav-toggle" class="icon-btn nav-mobile-only" aria-label="Open menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu hidden">
    <div class="container">
      {links.map((l) => (
        <a href={l.href} class={`nav-link ${isActive(l.href) ? "active" : ""}`}>{l.label}</a>
      ))}
    </div>
  </div>
</header>

<style>
  .nav-mobile-only { display: inline-flex; }
  @media (min-width: 860px) { .nav-mobile-only { display: none; } }
  .mobile-menu { border-top: 1px solid var(--color-border); padding-block: .75rem; }
  .mobile-menu.hidden { display: none; }
  @media (min-width: 860px) { .mobile-menu { display: none !important; } }
</style>

<script>
  const nt = document.getElementById("nav-toggle");
  const mm = document.getElementById("mobile-menu");
  nt?.addEventListener("click", () => mm?.classList.toggle("hidden"));
</script>

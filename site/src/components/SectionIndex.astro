---
// Generated table of contents for a folder hub (pending/<dir>/index.md):
// every note below the hub, grouped by sub-folder (e.g. Field Manual phases).
import { sectionGroups } from "../lib/notes.mjs";

const { notes, hub } = Astro.props;
const groups = sectionGroups(notes, hub);
const total = groups.reduce((sum, g) => sum + g.items.length + (g.hub ? 1 : 0), 0);
---
{total > 0 && (
  <section class="section-index mt-12 border-t border-border pt-8" aria-labelledby="section-index-title">
    <h2 id="section-index-title" class="section-title">in this section <span class="font-mono text-xs text-muted">({total})</span></h2>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      {groups.map((g) => (
        <div class="card card-pad">
          {g.hub ? (
            <a href={g.hub.url} class="cr-name hover:text-primary">{g.hub.data.title}</a>
          ) : (
            <span class="cr-name">{hub.data.title.split(/\s+[—-]\s+/)[0]} — general</span>
          )}
          {g.hub?.data.description && <p class="cr-blurb">{g.hub.data.description}</p>}
          {g.items.length > 0 && (
            <ul class="mt-3 space-y-1.5 text-sm">
              {g.items.map(({ note, depth }) => (
                <li style={depth ? `padding-left:${depth * 1}rem` : undefined}>
                  <a href={note.url} class="text-primary hover:underline">{note.data.title}</a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>
)}

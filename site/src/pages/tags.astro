---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site.mjs";
import { getArchiveNotes, tagListings } from "../lib/notes.mjs";

const notes = await getArchiveNotes();

// tag -> count, sorted by frequency then name
const counts = new Map();
for (const n of notes) {
  for (const t of n.data.tags || []) counts.set(t, (counts.get(t) || 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Tags",
  url: `${SITE.url}/tags/`,
  description: "All tags across f4zzie.dev Notes and Writeups.",
}];
---
<Base
  seo={{ title: "Tags", description: `All ${tags.length} tags across f4zzie.dev Notes and Writeups — filter each section without mixing them.`, jsonLd }}
  footer={{ noteCount: notes.length }}
>
  <section class="section">
    <div class="container">
      <div class="page-head">
        <span class="eyebrow">tags</span>
        <h1>Tags</h1>
        <p>{tags.length} tags across {notes.length} published notes and writeups. Shared tags link to each section separately.</p>
      </div>

      <div class="tag-cloud">
        {tags.length === 0 ? (
          <div class="empty-state" style="width:100%"><p class="es-msg">// no tags yet — notes are being rebuilt.</p></div>
        ) : tags.flatMap(([tag]) => {
          const sections = tagListings(notes, tag);
          return sections.map((section) => (
            <a href={section.url} class="tag">
              {tag}{sections.length > 1 && ` (${section.label})`} <b>{section.count}</b>
            </a>
          ));
        })}
      </div>
    </div>
  </section>
</Base>

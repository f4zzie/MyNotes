---
import Base from "../layouts/Base.astro";
import NoteCard from "../components/NoteCard.astro";
import { SITE, CATEGORY_META, slugifyCategory } from "../lib/site.mjs";
import { getNotes, groupByCategory } from "../lib/notes.mjs";

const notes = await getNotes();
const byCat = groupByCategory(notes);
const categories = [...byCat.keys()];
const featured = notes.slice(0, 6);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "f4zzie",
    url: SITE.url,
    sameAs: [SITE.github, SITE.x, SITE.htb],
    jobTitle: "Cybersecurity Researcher",
    knowsAbout: ["Malware Analysis","Reverse Engineering","Binary Exploitation","Capture The Flag","Penetration Testing"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    potentialAction: {
      "@type": "SearchAction",
      target: `${SITE.url}/notes?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];
---
<Base seo={{ jsonLd }} footer={{ noteCount: notes.length, categoryCount: categories.length }}>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="hero-grid-bg"></div>
    <div class="home">
      <div class="avatar-wrapper">
        <img class="avatar" src="https://github.com/f4zzie.png" alt="f4zzie" width="132" height="132" />
      </div>
      <p class="hero-kicker">security research · malware · reverse engineering · pwn · ctf</p>
      <h1 class="name">f4zzie</h1>
      <p class="tagline">
        A public vault of hands-on offensive-security research — {notes.length} writeups on the method,
        the reasoning, and the verification behind each one.
      </p>
      <div class="social-row">
        <a href={SITE.github} target="_blank" rel="noreferrer me" aria-label="GitHub" class="social-icon">
          <svg viewBox="0 0 24 24"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.31-.54-1.53.11-3.19 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.19.77.84 1.23 1.92 1.23 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.82 1.1.82 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>
        </a>
        <a href={SITE.x} target="_blank" rel="noreferrer me" aria-label="X" class="social-icon">
          <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href={SITE.htb} target="_blank" rel="noreferrer" aria-label="Hack The Box" class="social-icon">
          <svg viewBox="0 0 24 24"><path d="M11.996 0 1.66 6v12l10.336 6 10.343-6V6L11.996 0zm6.86 7.98v8.05l-6.86 3.98-6.853-3.98V7.98l6.853-3.98 6.86 3.98zm-6.86.02-4.02 2.33v.02l4.02 2.33 4.02-2.33-4.02-2.35z"/></svg>
        </a>
        <a href={`mailto:${SITE.email}`} aria-label="Email" class="social-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
        </a>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/notes" class="btn btn-primary">Explore writeups</a>
        <a href="/about" class="btn btn-outline">About</a>
      </div>
    </div>
  </section>

  <!-- LATEST WRITEUPS -->
  <section class="section pt-0">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Latest writeups</h2>
        <a href="/notes" class="view-all">View all →</a>
      </div>
      <div class="posts-grid">
        {featured.map((n) => <NoteCard note={n} />)}
      </div>
    </div>
  </section>

  <!-- RESEARCH TRACKS -->
  <section class="section pt-0">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Research tracks</h2>
        <a href="/notes" class="view-all">Browse notes →</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c) => (
          <a href={`/category/${slugifyCategory(c)}/`} class="note-card">
            <span class="category-badge">{byCat.get(c).length} notes</span>
            <h3 class="mt-4 text-lg font-bold text-heading">{c}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{CATEGORY_META[c]?.blurb || ""}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

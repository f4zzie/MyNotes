---
import Base from "../layouts/Base.astro";
import Panel from "../components/Panel.astro";
import { SITE, slugifyCategory } from "../lib/site.mjs";
import { getNotes, groupByCategory } from "../lib/notes.mjs";

const notes = await getNotes();
const byCat = groupByCategory(notes);
const categories = [...byCat.keys()];

const fmt = (d) =>
  d ? new Date(d).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" }) : null;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "f4zzie",
    url: SITE.url,
    sameAs: [SITE.github, SITE.x, SITE.htb],
    jobTitle: "Cybersecurity Researcher",
    knowsAbout: ["Malware Analysis","Reverse Engineering","Binary Exploitation","Capture The Flag","Penetration Testing"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    potentialAction: {
      "@type": "SearchAction",
      target: `${SITE.url}/notes?q={search_term_string}`,
      "query-input": "required name=search_term_string",
    },
  },
];
---
<Base seo={{ jsonLd }} footer={{ noteCount: notes.length, categoryCount: categories.length }}>
  <div class="page-head">
    <span class="eyebrow">writeups</span>
    <h1>Latest writeups</h1>
    <p>
      {notes.length > 0
        ? `${notes.length} challenges across ${categories.length} categories — the full method behind each solve: the reasoning, the commands, and the verification.`
        : "The vault is being rebuilt from scratch. New writeups are on the way."}
    </p>
  </div>

  {notes.length === 0 ? (
    <div class="empty-state">
      <p class="es-line">$ ls ./writeups</p>
      <p class="es-msg">// no writeups published yet — check back soon.</p>
    </div>
  ) : (
    <div class="feed">
      {notes.map((n) => (
        <a href={n.url} class="post-card">
          <span class="pc-cat">{n.data.category}</span>
          <h2>{n.data.title}</h2>
          {n.data.description && <p class="pc-desc">{n.data.description}</p>}
          <div class="pc-meta">
            {fmt(n.data.date) && <time>{fmt(n.data.date)}</time>}
            {n.data.tags?.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
          </div>
        </a>
      ))}
    </div>
  )}

  <Panel slot="panel" />
</Base>

---
import Base from "../layouts/Base.astro";
---
<Base seo={{ title: "Page not found", noindex: true }}>
  <section class="section">
    <div class="container flex flex-col items-center py-20 text-center">
      <p class="font-mono text-6xl font-bold text-primary">404</p>
      <h1 class="mt-4 text-3xl font-bold">This page slipped the sandbox.</h1>
      <p class="mt-3 max-w-md text-muted">The page you're looking for doesn't exist or has moved.</p>
      <div class="mt-8 flex gap-3">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/notes" class="btn btn-outline">Browse notes</a>
      </div>
    </div>
  </section>
</Base>

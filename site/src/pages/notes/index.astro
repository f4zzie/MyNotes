---
import Base from "../../layouts/Base.astro";
import NoteListing from "../../components/NoteListing.astro";
import { SITE } from "../../lib/site.mjs";
import { getFieldManualNotes, groupByCategory } from "../../lib/notes.mjs";

// Notes section = the CPTS field manual, listed in vault order (phase folders).
const notes = (await getFieldManualNotes()).sort((a, b) => a.id.localeCompare(b.id));
const hub = notes.find((n) => n.id === "field-manual");
const phases = new Set(notes.map((n) => n.id.split("/")[1]).filter((p) => /^\d+-/.test(p || "")));
const categoryCount = groupByCategory(notes).size;

const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Notes — CPTS Field Manual",
  url: `${SITE.url}/notes/`,
  description: "The CPTS & internal pentesting field manual by f4zzie: phase-by-phase checklists, commands and methodology.",
  hasPart: notes.slice(0, 50).map((n) => ({
    "@type": "TechArticle",
    headline: n.data.title,
    url: `${SITE.url}${n.url}`,
  })),
}];
---
<Base
  seo={{ title: "Notes — CPTS Field Manual", description: `The CPTS field manual: ${notes.length} pages across ${phases.size} phases of internal penetration testing — enumeration, exploitation, privilege escalation, lateral movement, procedures and tooling.`, jsonLd }}
  footer={{ noteCount: notes.length, categoryCount }}
>
  <section class="border-b border-border bg-surface py-10">
    <div class="container">
      <span class="eyebrow">notes</span>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">./notes</h1>
      <p class="mt-3 max-w-2xl text-muted">
        The CPTS &amp; internal pentesting field manual: {notes.length} pages across {phases.size} phases.
        grep by title, tag, or keyword, or start from the phase-by-phase map.
      </p>
      {hub && (
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={hub.url} class="btn btn-primary">Open the field manual hub →</a>
          <a href="/writeups" class="btn btn-outline">Looking for writeups?</a>
        </div>
      )}
    </div>
  </section>

  <NoteListing notes={notes} dir="./notes" placeholder="$ grep -ri 'kerberoast | pivoting | SMB | privesc' ./notes" />
</Base>

---
import Base from "../../layouts/Base.astro";
import NoteCard from "../../components/NoteCard.astro";
import { render } from "astro:content";
import { SITE, slugifyCategory } from "../../lib/site.mjs";
import { getArchiveNotes, relatedNotes } from "../../lib/notes.mjs";

export async function getStaticPaths() {
  const notes = await getArchiveNotes();
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, all: notes },
  }));
}

const { note, all } = Astro.props;
const { Content, headings } = await render(note);
const related = relatedNotes(all, note);
const catSlug = slugifyCategory(note.data.category);
const iso = note.data.date ? new Date(note.data.date).toISOString() : undefined;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: note.data.title,
    description: note.data.description,
    articleSection: note.data.category,
    keywords: (note.data.tags || []).join(", "),
    author: { "@type": "Person", name: "f4zzie", url: SITE.url },
    publisher: { "@type": "Person", name: "f4zzie" },
    mainEntityOfPage: `${SITE.url}${note.url}`,
    ...(iso ? { datePublished: iso, dateModified: iso } : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Notes", item: `${SITE.url}/notes/` },
      { "@type": "ListItem", position: 3, name: note.data.category, item: `${SITE.url}/category/${catSlug}/` },
      { "@type": "ListItem", position: 4, name: note.data.title, item: `${SITE.url}${note.url}` },
    ],
  },
];

const toc = (headings || []).filter((h) => h.depth === 2 || h.depth === 3);
---
<Base
  seo={{ title: note.data.title, description: note.data.description, type: "article", jsonLd }}
  footer={{ noteCount: all.length }}
>
  <article class="container-read py-10 lg:py-14">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
      <a href="/" class="footer-link">~</a><span>/</span>
      <a href="/notes" class="footer-link">writeups</a><span>/</span>
      <a href={`/category/${catSlug}/`} class="footer-link">{slugifyCategory(note.data.category)}</a>
    </nav>

    <header class="border-b border-border pb-6">
      <span class="category-badge">{note.data.category}</span>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{note.data.title}</h1>
      {note.data.description && <p class="mt-3 text-lg leading-8 text-muted">{note.data.description}</p>}
      <div class="mt-4 flex flex-wrap items-center gap-2 font-mono text-xs text-muted">
        {note.data.date && <time datetime={iso}>{new Date(note.data.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>}
        {note.data.tags?.map((t) => <a href={`/notes?q=${encodeURIComponent(t)}`} class="tag">{t}</a>)}
      </div>
    </header>

    {toc.length > 2 && (
      <details class="toc card mt-6 p-5" open>
        <summary class="font-bold">contents</summary>
        <ul class="mt-3 space-y-1.5 text-sm">
          {toc.map((h) => (
            <li class={h.depth === 3 ? "pl-4" : ""}>
              <a href={`#${h.slug}`} class="text-primary hover:underline">{h.text}</a>
            </li>
          ))}
        </ul>
      </details>
    )}

    <div class="prose mt-8">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="border-t border-border bg-surface py-12">
      <div class="container">
        <h2 class="section-title text-xl">related research</h2>
        <div class="mt-6 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
          {related.map((n) => <NoteCard note={n} />)}
        </div>
      </div>
    </section>
  )}
</Base>

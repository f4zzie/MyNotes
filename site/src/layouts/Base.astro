---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import VisitorTracker from "../components/VisitorTracker.astro";

const { seo = {}, footer = {} } = Astro.props;
const hasPanel = Astro.slots.has("panel");
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="f4zzie.dev" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- no-flash theme: apply saved theme (or OS preference) before first paint -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme") || "dark"; // Teal Dark is the signature default
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
      })();
    </script>
    <SEO {...seo} />
  </head>
  <body>
    <Sidebar />
    <div id="sidebar-backdrop"></div>

    <div class="main-wrap">
      <div id="mobile-topbar">
        <a href="/" class="logo" aria-label="f4zzie.dev home">
          <span class="p">f4zzie</span><span class="u">@dev</span><span class="path">:~$</span>
        </a>
        <button id="nav-toggle" class="icon-btn" aria-label="Open menu" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>

      <main class="flex-1">
        {hasPanel ? (
          <div class="shell-grid">
            <div class="shell-content"><slot /></div>
            <aside class="shell-panel"><slot name="panel" /></aside>
          </div>
        ) : (
          <slot />
        )}
      </main>

      <Footer noteCount={footer.noteCount} categoryCount={footer.categoryCount} />
    </div>

    <VisitorTracker />

    <script is:inline>
      (function () {
        var btn = document.getElementById("nav-toggle");
        var sb = document.getElementById("sidebar");
        var bd = document.getElementById("sidebar-backdrop");
        function close() { sb.classList.remove("open"); bd.classList.remove("open"); btn.setAttribute("aria-expanded", "false"); }
        btn && btn.addEventListener("click", function () {
          var open = sb.classList.toggle("open");
          bd.classList.toggle("open", open);
          btn.setAttribute("aria-expanded", String(open));
        });
        bd && bd.addEventListener("click", close);
      })();
    </script>
  </body>
</html>
